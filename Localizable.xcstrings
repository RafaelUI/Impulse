  "strings" : {
    "" : {

    },
    "·" : {
      "comment" : "A separator between the item type and the project title.",
      "isCommentAutoGenerated" : true
    },
    "·  %lld" : {
      "comment" : "A dot separator followed by the count of items in the section.",
      "isCommentAutoGenerated" : true
    },
    "«%@» будет удалён без возможности восстановления." : {
      "comment" : "A message in an alert that warns the user that the item they're about to delete will be permanently deleted and cannot be restored.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" wird endgültig gelöscht und kann nicht wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" will be permanently deleted and cannot be restored."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" sera définitivement supprimé et ne pourra pas être restauré."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» будет удалён без возможности восстановления."
          }
        }
      }
    },
    "«%@» и все его данные будут удалены без возможности восстановления." : {
      "comment" : "A message in a confirmation alert that informs the user that the project will be deleted permanently.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" und alle seine Daten werden endgültig gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" and all its data will be permanently deleted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" et toutes ses données seront définitivement supprimées."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» и все его данные будут удалены без возможности восстановления."
          }
        }
      }
    },
